---
const experiences = [
  {
    roleKey: 'experience.e1_role',
    role: 'Administrador de Sistemas',
    companyKey: 'experience.e1_company',
    company: 'Helados Kolibrí',
    locationKey: 'experience.e1_location',
    location: 'Güiria, Sucre',
    date: 'Abr 2024 — May 2024',
    bulletsKey: 'experience.e1_bullets',
    bullets: 'Mantenimiento preventivo y correctivo de computadores. Implementación de sistema de inventario digitalizado. Inducción a nuevos usuarios.',
  },
  {
    roleKey: 'experience.e2_role',
    role: 'Asistente de Sistemas',
    companyKey: 'experience.e2_company',
    company: 'Hotel Luciano Junior C.A.',
    locationKey: 'experience.e2_location',
    location: 'Maturín, Monagas',
    date: 'Dic 2021 — Oct 2022',
    bulletsKey: 'experience.e2_bullets',
    bullets: 'Desarrollo de scripts en PowerShell. Monitoreo de red empresarial. Gestión de sistemas administrativos (A2, HOSPES).',
  },
  {
    roleKey: 'experience.e3_role',
    role: 'Pasante de Sistemas',
    companyKey: 'experience.e3_company',
    company: 'Hotel Luciano Junior C.A.',
    locationKey: 'experience.e3_location',
    location: 'Maturín, Monagas',
    date: 'Oct 2021 — Dic 2021',
    bulletsKey: 'experience.e3_bullets',
    bullets: 'Diseño e implementación de sistema de inventario para control de computadoras por departamento.',
  },
];
---

<section id="experience" class="py-section">
  <div class="max-w-6xl mx-auto px-6">
    <div class="reveal">
      <p class="section-title" data-i18n="experience.label">EXPERIENCIA</p>
      <h2 class="text-display-lg font-bold mb-12" data-i18n="experience.title">Trayectoria Profesional</h2>
    </div>

    <div class="relative">
      <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px bg-border"></div>

      {experiences.map((exp, idx) => (
        <div class={`reveal stagger-${idx + 1} relative mb-12 last:mb-0`}>
          <div class={`flex flex-col md:flex-row ${idx % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
            <div class={`md:w-1/2 ${idx % 2 === 0 ? 'md:pr-12 md:text-right' : 'md:pl-12'}`}>
              <span class="font-mono text-xs text-text-muted">{exp.date}</span>
              <h3 class="text-lg font-bold mt-1" data-i18n={exp.roleKey}>{exp.role}</h3>
              <p class="text-sm text-accent font-medium" data-i18n={exp.companyKey}>{exp.company}</p>
              <p class="text-xs text-text-muted font-mono mt-1" data-i18n={exp.locationKey}>{exp.location}</p>
              <p class="text-sm text-text-secondary mt-2 leading-relaxed" data-i18n={exp.bulletsKey}>{exp.bullets}</p>
            </div>
          </div>

          <div class="absolute left-4 md:left-1/2 top-6 w-3 h-3 rounded-full bg-accent border-2 border-surface transform -translate-x-1/2 -translate-y-0.5"></div>
        </div>
      ))}
    </div>
  </div>
</section>
